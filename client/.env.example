# ── Client Production / Local Environment ──────────────────────────────
# In local development with Vite proxy, leave VITE_API_URL empty or unset.
# For production (Vercel @ https://www.smcs.digital), bake:
# VITE_API_URL=https://crm-oceh.onrender.com/api/v1
# VITE_SOCKET_URL=https://crm-oceh.onrender.com
#
# Android (Capacitor Remote URL) loads https://www.smcs.digital — see docs/ANDROID_CAPACITOR.md
VITE_API_URL=

# Optional: Real-time socket server origin if different from API base
VITE_SOCKET_URL=
