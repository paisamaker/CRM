# ── Client Production / Local Environment ──────────────────────────────
# In local development with Vite proxy, leave VITE_API_URL empty or unset.
# For production deployment (e.g. Vercel), set VITE_API_URL to your deployed backend origin + /api/v1:
# Example: https://starmedia-crm-api.onrender.com/api/v1
VITE_API_URL=

# Optional: Real-time socket server origin if different from API base
# Example: https://starmedia-crm-api.onrender.com
VITE_SOCKET_URL=
