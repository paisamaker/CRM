# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# ── MongoDB ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/starmedia-crm

# ── Auth / JWT ───────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false

# ── Allowed email domains (comma-separated) ──────────
ALLOWED_DOMAINS=starmediainfluencer.com

# ── Google OAuth (Workspace SSO) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── MFA ──────────────────────────────────────────────
MFA_ISSUER=STAR MEDIA CRM

# ── Email (Nodemailer / SMTP) ────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="STAR MEDIA CRM <noreply@starmediainfluencer.com>"

# ── File storage (Cloudinary or local) ───────────────
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_MB=10

# ── Company ──────────────────────────────────────────
COMPANY_NAME=STAR MEDIA
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata
