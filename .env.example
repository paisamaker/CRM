# ── App ──────────────────────────────────────────────
NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
API_URL=http://localhost:5000

# ── MongoDB ──────────────────────────────────────────
MONGODB_URI=mongodb://localhost:27017/starmedia-crm

# ── Auth / JWT ───────────────────────────────────────
JWT_ACCESS_SECRET=change-me-access-secret-min-32-chars!!
JWT_REFRESH_SECRET=change-me-refresh-secret-min-32-chars!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
COOKIE_SECURE=false

# ── Allowed email domains (comma-separated) ──────────
ALLOWED_DOMAINS=starmediainfluencer.com

# ── Google OAuth (Workspace SSO) ─────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=http://localhost:5000/api/v1/auth/google/callback

# ── MFA ──────────────────────────────────────────────
MFA_ISSUER=STAR MEDIA CRM

# ── Email (Nodemailer / SMTP) ────────────────────────
SMTP_HOST=smtp.ethereal.email
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="STAR MEDIA CRM <noreply@starmediainfluencer.com>"

# ── File storage (Cloudinary or local) ───────────────
# Use "cloudinary" on Render/Railway (ephemeral disk). "local" is fine for laptop + persistent volume.
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_MB=10

# ── Company ──────────────────────────────────────────
COMPANY_NAME=STAR MEDIA
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# ── AI Financial Document Scanning (Receipt & Invoice OCR) ──────────────
# Options: 'auto' (preferred AI first, fallback to offline OCR), 'gemini', 'openai', or 'heuristic'
AI_OCR_PROVIDER=auto
DOCUMENT_SCAN_MAX_MB=15

# Google Gemini API (Recommended: Gemini 1.5 Flash / 2.0 Flash multimodal PDF & image parsing)
# Get key: https://aistudio.google.com/app/apikey (Free tier available)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (Optional alternative: GPT-4o-mini vision and JSON schema parsing)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
