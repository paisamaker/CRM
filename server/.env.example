# ── Server Production / Local Environment ──────────────────────────────
NODE_ENV=production
PORT=5000

# Comma-separated list of allowed frontend origins for CORS and Socket.io
# Include your Vercel production domain and local dev origins
# Example: https://starmedia-crm.vercel.app,http://localhost:5173
CLIENT_URL=https://your-crm-frontend.vercel.app

# Backend Public API URL (used for OAuth callbacks and system webhooks)
# Example: https://starmedia-crm-api.onrender.com
API_URL=https://your-crm-backend.onrender.com

# ── MongoDB Connection ──────────────────────────────────────────────────
# Production MongoDB connection URI (e.g. MongoDB Atlas)
MONGODB_URI=mongodb+srv://<username>:<password>@cluster0.xxxxx.mongodb.net/starmedia-crm?retryWrites=true&w=majority

# ── Auth / JWT ──────────────────────────────────────────────────────────
# Cryptographically strong secrets (minimum 32 characters)
JWT_ACCESS_SECRET=replace-with-a-secure-random-32-char-secret-key!
JWT_REFRESH_SECRET=replace-with-a-secure-random-32-char-secret-key!
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
# Set COOKIE_SECURE=true in production (HTTPS)
COOKIE_SECURE=true

# ── Allowed Email Domains ───────────────────────────────────────────────
# Comma-separated allowed corporate domains for registration/login
ALLOWED_DOMAINS=starmediainfluencer.com

# ── Google OAuth (Optional SSO) ────────────────────────────────────────
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_CALLBACK_URL=https://your-crm-backend.onrender.com/api/v1/auth/google/callback

# ── MFA ─────────────────────────────────────────────────────────────────
MFA_ISSUER=STAR MEDIA CRM

# ── Email (SMTP / Nodemailer) ───────────────────────────────────────────
SMTP_HOST=smtp.sendgrid.net
SMTP_PORT=587
SMTP_USER=apikey
SMTP_PASS=
SMTP_FROM="STAR MEDIA CRM <noreply@starmediainfluencer.com>"

# ── File Storage ────────────────────────────────────────────────────────
# Use 'cloudinary' for serverless/ephemeral cloud hosting (Render/Railway), or 'local' with persistent volume
STORAGE_PROVIDER=local
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=
UPLOAD_MAX_MB=10

# ── Company Defaults ────────────────────────────────────────────────────
COMPANY_NAME=STAR MEDIA
DEFAULT_CURRENCY=INR
DEFAULT_TIMEZONE=Asia/Kolkata

# ── AI Financial Document Scanning (Receipt & Invoice OCR) ──────────────
# Provider options: 'auto' (cloud AI first with zero-cost fallback), 'gemini', 'openai', or 'heuristic'
AI_OCR_PROVIDER=auto
DOCUMENT_SCAN_MAX_MB=15

# Google Gemini API (Recommended: Gemini 1.5 Flash / 2.0 Flash multimodal PDF & image parsing)
# Get key: https://aistudio.google.com/app/apikey (Free tier available)
# Never commit real keys. Set this only in local .env / Render dashboard.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# OpenAI API (Optional alternative: GPT-4o-mini vision and JSON schema parsing)
# Get key: https://platform.openai.com/api-keys
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
